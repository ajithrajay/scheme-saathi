    {
      "id": "nmmss",
      "name": "National Means-cum-Merit Scholarship",
      "name_ta": "தேசிய வருவாய் வழி மற்றும் திறன் படிப்புதவித் தொகை",
      "category": "School education",
      "jurisdiction": "India",
      "benefit": "See current official scheme award and renewal conditions",
      "description": "School scholarship: preliminary income and marks screening.",
      "source_ids": [
