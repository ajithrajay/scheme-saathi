{
  "sources": [
    {
      "id": "tn-tils-20260929",
      "title": "Tamil Nadu Institute of Labour Studies — Government Schemes",
      "url": "https://tils.tn.gov.in/schemes",
      "section": "Government Schemes: Pudhumai Penn / Tamil Pudhalvan",
      "checked_at": "2026-09-29",
      "published_at": null,
      "effective_from": null,
      "snapshot_kind": "reviewed_paraphrase",
      "text": "The institute describes monthly assistance of INR 1,000 for women under Pudhumai Penn and men under Tamil Pudhalvan. It lists continuous schooling from classes 6 to 12 in government schools or Tamil-medium government-aided schools, followed by higher education. It directs applicants to UMIS with institute assistance. Its document list includes school study evidence, community and income certificates, bank passbook, Aadhaar and admission proof. This institutional summary is not a complete set of governing orders or course exclusions."
    },
    {
      "id": "nmms-moe-2025",
      "title": "Ministry of Education — NMMSS application and verification guidance",
      "url": "https://dsel.education.gov.in/sites/default/files/update/PIB2140874.pdf",
      "section": "Eligibility and NSP workflow",
      "checked_at": "2026-09-29",
      "published_at": null,
      "effective_from": null,
      "snapshot_kind": "reviewed_paraphrase",
      "text": "The Ministry describes NMMSS for meritorious school pupils, with parental annual income up to INR 350,000 and a minimum of 55 percent in class VII, relaxed by five percentage points for SC/ST applicants. State or UT selection and the applicable school conditions must also be met. Applications and verification use the National Scholarship Portal. The initial rules here cover income and prior marks only; school exclusions, selection requirements, renewal and current-year instructions require complete review."
    },
    {
      "id": "nsp-20260929",
      "title": "National Scholarship Portal — student application route",
      "url": "https://scholarships.gov.in/",
      "section": "Students / One Time Registration",
      "checked_at": "2026-09-29",
      "published_at": null,
      "effective_from": null,
      "snapshot_kind": "reviewed_paraphrase",
      "text": "NSP requires an OTR identifier for scholarship applications. Registration may require identity and face-authentication steps. Overall portal availability is not evidence that a particular scholarship application window is open. Follow the current scheme-specific deadline and institution verification instructions."
    },
    {
      "id": "demo-policy-v1",
      "title": "Fictional education grant — browser test fixture",
      "url": null,
      "section": "Fixture policy 1.0",
      "checked_at": "2026-09-29",
      "snapshot_kind": "synthetic",
      "text": "This is not a government scheme. The fictional grant accepts Tamil Nadu residents aged 18 through 30 inclusive whose annual household income is at most INR 250,000 and who are enrolled in higher education. A study certificate is required. The test form has profile, document and final-submission pages."
    }
  ],
