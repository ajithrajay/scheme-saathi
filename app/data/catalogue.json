        "nsp-20260929"
      ],
      "rule": {
        "id": "nmms-all",
        "op": "ALL",
        "children": [
          {
            "id": "nmms-income",
            "field": "annual_household_income_inr",
            "op": "lte",
            "value": 350000,
            "label": "Annual parental income up to ₹3,50,000",
            "label_ta": "ஆண்டு பெற்றோர் வருமானம் ₹3,50,000 வரை",
            "source_id": "nmms-moe-2025",
            "source_section": "Eligibility"
          },
          {
            "id": "nmms-marks",
            "op": "ANY",
            "children": [
              {
                "id": "nmms-standard-marks",
                "field": "class_7_percentage",
                "op": "gte",
                "value": 55,
                "label": "At least 55% in class VII",
                "label_ta": "7ஆம் வகுப்பில் குறைந்தது 55%",
                "source_id": "nmms-moe-2025",
                "source_section": "Eligibility"
              },
              {
                "id": "nmms-relaxed",
                "op": "ALL",
                "children": [
                  {
                    "id": "nmms-category",
                    "field": "category",
                    "op": "in",
                    "value": [
                      "SC",
                      "ST"
                    ],
                    "label": "SC/ST relaxation category",
                    "label_ta": "SC/ST தளர்வுப் பிரிவு",
                    "source_id": "nmms-moe-2025",
                    "source_section": "Eligibility"
                  },
                  {
                    "id": "nmms-relaxed-marks",
                    "field": "class_7_percentage",
                    "op": "gte",
                    "value": 50,
                    "label": "At least 50% for SC/ST",
                    "label_ta": "SC/ST பிரிவுக்கு குறைந்தது 50%",
                    "source_id": "nmms-moe-2025",
                    "source_section": "Eligibility"
                  }
                ],
                "label": "Eligibility requirements",
                "label_ta": "தகுதி விதிகள்"
              }
            ],
            "label": "Eligibility requirements",
            "label_ta": "தகுதி விதிகள்"
          }
        ],
        "label": "Eligibility requirements",
        "label_ta": "தகுதி விதிகள்"
