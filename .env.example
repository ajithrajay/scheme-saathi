# Local defaults. Copy to .env. Never commit .env.
SCHEMESAATHI_MODE=local
SCHEMESAATHI_PORT=8765
SCHEMESAATHI_HEADLESS=0
SCHEMESAATHI_MAX_BROWSERS=1
# Optional: set a random permanent owner key; otherwise run.py prints a new one.
SCHEMESAATHI_OWNER_KEY=
# Optional AI; deterministic fields and browser adapters work without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SCHEMESAATHI_SEMANTIC=0
# Required for cloud mode. See DEPLOY.md.
SCHEMESAATHI_PUBLIC_URL=
DATABASE_URL=
SCHEMESAATHI_ENCRYPTION_KEY=
